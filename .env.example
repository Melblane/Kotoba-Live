# Copy to .env and fill in. Keys are read by the server only and never sent to the browser.

# ---------------------------------------------------------------------------
# Speech recognition (any OpenAI-compatible /audio/transcriptions endpoint)
# ---------------------------------------------------------------------------
# OpenAI:  https://api.openai.com/v1            model: whisper-1 (or gpt-4o-mini-transcribe)
# Groq:    https://api.groq.com/openai/v1       model: whisper-large-v3-turbo
# Local:   http://localhost:8000/v1             (faster-whisper-server, whisper.cpp server, ...)
#          local servers usually ignore the key, but it must be non-empty
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
# verbose_json returns confidence data used to drop hallucinated text.
# Defaults to json for gpt-4o* models, verbose_json otherwise.
# STT_RESPONSE_FORMAT=verbose_json

# ---------------------------------------------------------------------------
# Translation (any OpenAI-compatible /chat/completions endpoint)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Leave empty (LLM_TEMPERATURE=) for models that reject a temperature value.
LLM_TEMPERATURE=0.2

# Shortcut: if you use OpenAI for both, set only this.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# 127.0.0.1 keeps the server private to this machine. Use 0.0.0.0 only behind HTTPS
# and together with ACCESS_TOKEN.
HOST=127.0.0.1
# Comma separated extra browser origins allowed to open the WebSocket.
# Same-origin requests (the bundled UI) are always allowed.
ALLOWED_ORIGINS=
# If set, clients must enter this token in Settings before they can start a session.
ACCESS_TOKEN=
MAX_CONNECTIONS_PER_IP=3
# Set to false to skip live partial transcripts (cuts speech-to-text cost roughly 4x).
ENABLE_PARTIALS=true
